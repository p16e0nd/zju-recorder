# Optional runtime configuration.
# The server always binds 127.0.0.1; nothing here is required for normal use.

# Web UI port.
PORT=8787

# Classroom API defaults.
ZJU_TENANT=112
ZJU_LIST_BASE=https://classroom.zju.edu.cn/courseapi/v2/course-live
ZJU_DETAIL_BASE=https://yjapi.cmc.zju.edu.cn/courseapi/v2/course-live

# Upstream fetch timeout (ms) for the local proxies used by playback and recording.
# ZJU_PROXY_TIMEOUT_MS=20000
# Signed-URL cache behavior.
# ZJU_AUTHKEY_GRACE=10800
# ZJU_STREAM_FALLBACK_TTL=1800

# Background stream-address precache: which campuses, and how often (seconds).
ZJU_AUTOCACHE_ROOMS=紫金港西,紫金港东,紫金港北
ZJU_AUTOCACHE_INTERVAL=600

# Card covers: the server pulls one frame from a live stream on demand.
# Concurrency and disk-cache lifetime (ms). Covers are off by default in the UI.
# ZJU_THUMB_PARALLEL=5
# ZJU_THUMB_TTL_MS=1800000

# Teacher ratings (chalaoshi): manual sync only, results stored in ~/.zju_chalaoshi.json.
# Domains are tried in order.
ZJU_CHALAOSHI_BASES=https://dahua309.uk,https://chalaoshi.de
# ZJU_CHALAOSHI_GAP_MS=1200
# ZJU_CHALAOSHI_TIMEOUT_MS=9000

# Local speech recognition (ASR sidecar). Normally left unset - see asr/README.md.
# ZJU_ASR_PYTHON=
# ZJU_ASR_MODELS=
# ZJU_ASR_PROFILE=streaming-zh
# ZJU_ASR_HUNG_MS=
